generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlayerRole {
  BATSMAN
  BOWLER
  ALLROUNDER
  WICKETKEEPER
  SETTER
  SPIKER
  LIBERO
  BLOCKER
  OPPOSITE
  DEFENDER
}

enum PlayerStatus {
  UNSOLD
  SOLD
  PENDING
}

model Auction {
  id        String   @id @default(uuid())
  name      String
  sport     String   @default("CRICKET") // CRICKET or VOLLEYBALL
  hostId    String   // Clerk User ID of the host
  status    String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams     Team[]
  players   Player[]
  bids      Bid[]
}

model Team {
  id             String   @id @default(uuid())
  name           String
  shortName      String
  logoUrl        String?
  budget         Float
  remainingPurse Float
  maxPlayers     Int      @default(15)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auctionId      String
  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  players        Player[]
  bids           Bid[]

  @@unique([auctionId, name])
  @@unique([auctionId, shortName])
}

model Player {
  id          String       @id @default(uuid())
  name        String
  photoUrl    String?
  age         String
  role        PlayerRole
  basePrice   Float
  soldPrice   Float?
  status      PlayerStatus @default(PENDING)
  isRecalled  Boolean      @default(false)
  stats       Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  auctionId   String
  auction     Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  bids        Bid[]
}

model Bid {
  id        String   @id @default(uuid())
  amount    Float
  timestamp DateTime @default(now())

  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
